# Copy to `.env` for local use. NEVER commit `.env`.
# The Elexon Insights API used here requires no API key (verified: unauthenticated
# requests succeed). Any value below is a placeholder or a non-secret default.

# ---------- Backend ----------
APP_ENV=development                      # development | production | test
LOG_LEVEL=INFO
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Comma-separated list of allowed browser origins (dev only; prod serves same-origin)
CORS_ALLOW_ORIGINS=http://localhost:5173

# ---------- Elexon Insights API ----------
ELEXON_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1
ELEXON_TIMEOUT_SECONDS=60
ELEXON_MAX_RETRIES=3
# Optional; the public API needs no key. Leave blank unless Elexon introduces one.
ELEXON_API_KEY=

# ---------- Data source mode ----------
# snapshot : read pinned real Elexon data from data/snapshots (default; deterministic, offline)
# live     : fetch from Elexon on startup / refresh and cache locally
# synthetic: use clearly-labelled SYNTHETIC fixtures (development/tests only)
DATA_SOURCE_MODE=snapshot
DATA_SNAPSHOT_DIR=./data/snapshots
DATA_CACHE_DIR=./data/cache

# ---------- Analysis defaults (all overridable per request) ----------
ANALYSIS_START_DATE=2026-01-01           # first permitted delivery (settlement) date
ANALYSIS_END_DATE=2026-01-31             # last permitted delivery (settlement) date
DECISION_TIMEZONE=Europe/London
DECISION_CUTOFF_TIME=09:50               # local clock time on the decision day (see docs/planning/05-analytics-methodology.md)
DECISION_DAYS_BEFORE_DELIVERY=1          # D-1 day-ahead decision
FORECAST_AVAILABILITY_LAG_MINUTES=0      # assumed delay between publishTime and usability
DUPLICATE_CONFLICT_POLICY=exclude        # exclude | strict (see methodology doc §2.3)
HOUR_ALIGNMENT=start                     # start (ASSUMED, unverified) | end (sensitivity only)
ANALYSIS_RESOLUTION=half_hour            # half_hour | hourly

# ---------- Frontend (Vite) ----------
VITE_API_BASE_URL=http://localhost:8000
