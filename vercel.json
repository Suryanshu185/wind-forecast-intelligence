{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": null,
  "buildCommand": "cd frontend && npm ci --no-audit --no-fund && npm run build",
  "outputDirectory": null,
  "functions": {
    "api/index.py": {
      "maxDuration": 30,
      "includeFiles": "{backend/app/**,data/snapshots/**,frontend/dist/**}",
      "excludeFiles": "{frontend/src/**,frontend/node_modules/**,**/node_modules/**,docs/**,backend/tests/**,backend/.venv/**,.env*,.vercel/**,.git/**}"
    }
  }
}
